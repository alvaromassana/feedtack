#. Plugin Name of the plugin
#: feedtack.php
msgid "Feedtack"
msgstr ""

#. Plugin URI of the plugin
#. Author URI of the plugin
#: feedtack.php
msgid "https://websalia.com"
msgstr ""

#. Description of the plugin
#: feedtack.php
msgid "A floating button so your client can comment on the site they are reviewing, pointing at the exact element. Only loads outside production."
msgstr "Botón flotante para que el cliente comente su web durante la revisión, señalando el elemento concreto. Solo se carga en entornos que no son producción."

#. Author of the plugin
#: feedtack.php
msgid "Websalia"
msgstr ""

#: feedtack.php:148
msgid "Settings"
msgstr "Ajustes"

#: feedtack.php:227
msgid "Puts a floating button on the site so your client can comment on what they see, pointing at the exact element. The comments arrive by email and stay in a list the client can read and edit."
msgstr "Pone un botón flotante en la web para que el cliente comente lo que ve, señalando el elemento concreto. Los comentarios llegan por correo y quedan en una lista que el propio cliente puede consultar y editar."

#: feedtack.php:232
msgid "Right now it IS loading."
msgstr "Ahora mismo SE ESTÁ CARGANDO."

#: feedtack.php:232
msgid "Right now it is NOT loading."
msgstr "Ahora mismo NO se carga."

#. translators: %s: the environment WordPress reports, e.g. production.
#: feedtack.php:235
#, php-format
msgid "Environment detected: %s."
msgstr "Entorno detectado: %s."

#: feedtack.php:238
msgid "This site is production, so the widget is switched off for safety."
msgstr "Este sitio es producción, así que el widget queda desactivado por seguridad."

#: feedtack.php:240
msgid "It is switched off in the settings below."
msgstr "Está desactivado en los ajustes de abajo."

#: feedtack.php:247
msgid "Careful:"
msgstr "Cuidado:"

#: feedtack.php:248
msgid "it is forced on a production site. Every visitor sees the button, can write comments and can read everyone else's. Switch it off as soon as the review is over."
msgstr "está forzado en un sitio de producción. Cualquier visitante ve el botón, puede escribir comentarios y puede leer los de los demás. Desactívalo en cuanto termine la revisión."

#: feedtack.php:256
msgid "Active"
msgstr "Activo"

#: feedtack.php:260
msgid "Load the widget on this site"
msgstr "Cargar el widget en esta web"

#: feedtack.php:265
msgid "Client identifier"
msgstr "Identificador del cliente"

#: feedtack.php:268
msgid "Shows up in the email subject and keeps each site's comments apart. No spaces, no accents."
msgstr "Aparece en el asunto del correo y separa los comentarios de cada web. Sin espacios ni acentos."

#: feedtack.php:272
msgid "Server"
msgstr "Servidor"

#: feedtack.php:275
msgid "https only. This site's domain has to be allowed on the server, otherwise the browser blocks everything it sends."
msgstr "Solo https. El dominio de esta web tiene que estar autorizado en el servidor, si no el navegador bloquea los envíos."

#: feedtack.php:279
msgid "Widget file"
msgstr "Fichero del widget"

#: feedtack.php:282
msgid "Leave it empty and the copy inside the plugin is used, which is the recommended way: this site then depends on nobody's repository or CDN. Put a URL here only if you want to serve the file from somewhere else."
msgstr "Déjalo vacío y se usa la copia que viene dentro del plugin, que es lo recomendado: así esta web no depende de ningún repositorio ni CDN de nadie. Ponle una URL solo si quieres servir el fichero desde otro sitio."

#: feedtack.php:286
msgid "Colour"
msgstr "Color"

#: feedtack.php:289
msgid "Usually the client's brand colour."
msgstr "Normalmente el color de marca del cliente."

#: feedtack.php:293
msgid "Button text"
msgstr "Texto del botón"

#: feedtack.php:297
msgid "Position"
msgstr "Posición"

#: feedtack.php:307
msgid "Tab on the right edge (discreet)"
msgstr "Pestaña pegada al borde derecho (discreta)"

#: feedtack.php:308
msgid "Bottom right"
msgstr "Abajo a la derecha"

#: feedtack.php:309
msgid "Bottom left"
msgstr "Abajo a la izquierda"

#: feedtack.php:310
msgid "Top right"
msgstr "Arriba a la derecha"

#: feedtack.php:325
msgid "Panel language"
msgstr "Idioma del panel"

#: feedtack.php:330
msgid "The page's own (automatic)"
msgstr "El de la página (automático)"

#: feedtack.php:344
msgid "Set it by hand when the site is in one language and whoever reviews it speaks another."
msgstr "Ponlo a mano cuando la web esté en un idioma y quien la revisa hable otro."

#: feedtack.php:348
msgid "Production"
msgstr "Producción"

#: feedtack.php:352
msgid "Load it even when the environment is production"
msgstr "Cargarlo también si el entorno es producción"

#. translators: 1: WP_ENVIRONMENT_TYPE constant, 2: wp-config.php file name.
#: feedtack.php:358
#, php-format
msgid "Leave it unticked unless you know exactly what you are doing. The environment is set with %1$s in %2$s (local, development, staging or production)."
msgstr "Déjalo desmarcado salvo que sepas muy bien lo que haces. El entorno se define con %1$s en %2$s (local, development, staging o production)."

#: feedtack.php:370
msgid "How your team gets in"
msgstr "Cómo entra el equipo"

#. translators: %s: the URL parameter that carries the team key.
#: feedtack.php:375
#, php-format
msgid "To mark comments as resolved or delete them, open the site once with %s. The key is then kept in that browser. Anyone without it can write, edit their own, and confirm or reopen what you have already resolved, but nothing else."
msgstr "Para poder marcar comentarios como resueltos o eliminarlos, hay que abrir la web una vez con %s. La clave se queda guardada en ese navegador. Quien no la tenga puede escribir, editar lo suyo y confirmar o reabrir lo que ya hayáis resuelto, pero nada más."
